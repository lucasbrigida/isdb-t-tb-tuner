# Build directories
build/
build*/
releases/*.zip
releases/**/*.zip
!releases/**/.gitkeep
deps/
.agents/

# Local runtime generated files
channels.json
channels.m3u

# Logs temporarios e de investigacao
*.log
!tests/golden/*.log

# Test data captures
tests/data/*.raw
tests/golden/*current_run*.ts

# Benchmark results
bench/results/*.json
!bench/results/.gitkeep

# Compiled binaries
*.exe
*.dll
*.o
*.obj
*.a

# Never ignore anything in tools
!tools/
!tools/**
!tools/*.exe
!tools/*.dll
!tools/**/*.exe
!tools/**/*.dll
