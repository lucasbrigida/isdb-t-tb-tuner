# Build directories
build/
deps/
channels.m3u
.agents/

# Test data captures
tests/data/*.raw
tests/golden/*current_run*.ts

# Benchmark results
bench/results/*.json
!bench/results/.gitkeep

# Compiled binaries
*.exe
*.dll
*.o
*.obj
*.a

# Never ignore anything in tools
!tools/
!tools/**
!tools/*.exe
!tools/*.dll
!tools/**/*.exe
!tools/**/*.dll
